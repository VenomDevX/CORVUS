{
  "$schema-note": "Corvus design tokens — single source of truth. Tailwind theme and brand assets derive from this file.",
  "color": {
    "bg": {
      "caviar": "#010101",
      "rein": "#312E2E",
      "shadow": "#4E4949",
      "saddle": "#5C5551"
    },
    "accent": {
      "electric-blue": "#FFFFFF",
      "bright": "#FFFFFF",
      "dim": "#B3B3B3",
      "deep": "#666666"
    },
    "fg": {
      "white": "#FFFFFF",
      "muted": "#D7D7D7",
      "faint": "#8B8B8B"
    },
    "semantic": {
      "success": "#3DD68C",
      "warning": "#F5B83D",
      "danger": "#F26D6D"
    },
    "glass": {
      "fill": "rgba(49, 46, 46, 0.50)",
      "border": "rgba(78, 73, 73, 0.25)",
      "blur": "16px"
    },
    "light": {
      "bg": { "base": "#D7D7D7", "surface": "#F4F4F4", "surface-raised": "#FFFFFF" },
      "fg": { "primary": "#010101", "muted": "#4E4949", "faint": "#5C5551" },
      "glass": { "fill": "rgba(1, 1, 1, 0.05)", "border": "rgba(1, 1, 1, 0.10)" }
    },
    "gradient": {
      "soft": ["#FFFFFF", "#0B1220"],
      "orb": ["#FFFFFF", "#DDDDDD", "#888888", "#0B1220"]
    }
  },
  "typography": {
    "font": {
      "ui": "Inter, 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif",
      "display": "Inter, 'Segoe UI Variable', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace"
    },
    "scale": {
      "display": { "size": "40px", "lineHeight": "48px", "weight": 650, "tracking": "-0.02em" },
      "h1": { "size": "28px", "lineHeight": "36px", "weight": 600, "tracking": "-0.01em" },
      "h2": { "size": "22px", "lineHeight": "30px", "weight": 600, "tracking": "-0.01em" },
      "h3": { "size": "18px", "lineHeight": "26px", "weight": 600, "tracking": "0" },
      "h4": { "size": "16px", "lineHeight": "24px", "weight": 600, "tracking": "0" },
      "body": { "size": "14px", "lineHeight": "22px", "weight": 400, "tracking": "0" },
      "body-sm": { "size": "13px", "lineHeight": "20px", "weight": 400, "tracking": "0" },
      "caption": { "size": "12px", "lineHeight": "16px", "weight": 500, "tracking": "0.01em" },
      "mono": { "size": "13px", "lineHeight": "20px", "weight": 400, "tracking": "0" }
    }
  },
  "spacing": { "base": 4, "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80] },
  "radius": { "sm": "4px", "default": "8px", "lg": "12px", "xl": "16px", "full": "9999px" },
  "elevation": {
    "glass-1": "0 2px 8px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.06)",
    "glass-2": "0 8px 24px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08)",
    "glass-3": "0 16px 48px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.10)",
    "glow-accent": "0 0 24px rgba(255, 255, 255, 0.15)",
    "glow-accent-strong": "0 0 48px rgba(255, 255, 255, 0.25)"
  },
  "motion": {
    "duration": { "fast": "150ms", "base": "250ms", "slow": "400ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "orb": {
      "idle": { "description": "slow ambient breathing", "period": "4s", "scaleRange": [0.97, 1.03], "opacityRange": [0.85, 1] },
      "listening": { "description": "reactive pulse synced to input audio level", "period": "1.2s", "scaleRange": [0.98, 1.12] },
      "thinking": { "description": "rotating conic shimmer, no audio", "period": "2.4s", "rotation": "360deg" },
      "speaking": { "description": "waveform-reactive multi-ring pulse synced to output audio", "period": "0.9s", "scaleRange": [0.96, 1.1] }
    }
  }
}
