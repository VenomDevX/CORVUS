{
  "name": "corvus-frontend",
  "productName": "Corvus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Corvus desktop app (Electron + React)",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron,esbuild \"vite\" \"npm run dev:electron\" \"npm run build:electron -- --watch\"",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && wait-on file:dist-electron/main.cjs && electron .",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --external:electron-updater --format=cjs --outdir=dist-electron --out-extension:.js=.cjs",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.0",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.11.0",
    "lucide-react": "^1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.2",
    "vite": "^5.4.3",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  }
}
